---

<section id="skills" class="py-20 md:py-28 relative">
  <div class="section-container">
    <!-- Section header -->
    <div class="mb-12 reveal">
      <div class="flex items-center gap-2 font-mono text-xs text-accent tracking-wider uppercase mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        <span>Skills & Technologies</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-text tracking-tight">
        Tools I work with
      </h2>
      <p class="text-base text-text-muted max-w-xl mt-2">
        Technologies I use regularly or am actively learning, organized by domain.
      </p>
    </div>

    <!-- Clean Grid of Skill Groups -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        skillGroups.map((group) => {
          const isExploring = group.icon === "compass";

          return (
            <div
              class={`reveal p-6 rounded-2xl bg-surface border ${
                isExploring
                  ? "border-dashed border-border"
                  : "border-border"
              } clean-card flex flex-col justify-between`}
            >
              <div>
                <div class="flex items-center justify-between mb-4">
                  <div class="flex items-center gap-2.5">
                    <svg
                      class={`w-4 h-4 ${isExploring ? "text-secondary" : "text-accent"}`}
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke-width="1.8"
                      stroke="currentColor"
                    >
                      <Fragment set:html={iconMap[group.icon] || iconMap.code} />
                    </svg>
                    <h3 class="font-semibold text-text text-base">
                      {group.label}
                    </h3>
                  </div>

                  {isExploring && (
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono text-secondary bg-secondary/10 border border-secondary/20">
                      exploring
                    </span>
                  )}
                </div>

                <div class="flex flex-wrap gap-1.5">
                  {group.skills.map((skill) => (
                    <span class="px-2.5 py-1 text-xs font-mono bg-surface-alt text-text-muted rounded-md border border-border/80">
                      {skill}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
