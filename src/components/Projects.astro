---
import { projects, siteConfig } from "../data/site";

const projectThemes: Record<
  string,
  {
    tag: string;
    accent: string;
    border: string;
  }
> = {
  cyan: {
    tag: "text-accent",
    accent: "text-accent",
    border: "border-accent/30",
  },
  violet: {
    tag: "text-secondary",
    accent: "text-secondary",
    border: "border-secondary/30",
  },
  indigo: {
    tag: "text-indigo-400",
    accent: "text-indigo-400",
    border: "border-indigo-400/30",
  },
  emerald: {
    tag: "text-emerald-400",
    accent: "text-emerald-400",
    border: "border-emerald-400/30",
  },
};
---

<section id="projects" class="py-20 md:py-28 relative">
  <div class="section-container">
    <!-- Section header -->
    <div class="mb-14 reveal">
      <div class="flex items-center gap-2 font-mono text-xs text-accent tracking-wider uppercase mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-accent" aria-hidden="true"></span>
        <span>Featured Work</span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <h2 class="text-3xl sm:text-4xl font-bold text-text tracking-tight">
            Things I've built
          </h2>
          <p class="text-base text-text-muted max-w-xl mt-2">
            Selected projects focusing on privacy, developer tooling, and self-hosted software.
          </p>
        </div>
        <a
          href={siteConfig.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-mono text-text-muted hover:text-accent transition-colors shrink-0"
        >
          <span>More on GitHub</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- Editorial Projects List with Varied Compositions -->
    <div class="space-y-10 sm:space-y-12">
      {
        projects.filter((p) => p.featured).map((project, index) => {
          const theme = projectThemes[project.color] || projectThemes.cyan;
          const isEven = index % 2 === 1;

          return (
            <article class="reveal group">
              <div
                class={`p-6 sm:p-8 lg:p-10 rounded-2xl bg-surface border border-border clean-card grid lg:grid-cols-12 gap-8 items-center`}
              >
                {/* Content Area */}
                <div
                  class={`lg:col-span-7 flex flex-col gap-4 ${
                    isEven ? "lg:order-2" : "lg:order-1"
                  }`}
                >
                  <!-- Tagline & Tech Category -->
                  <div class="flex items-center gap-3">
                    <span class={`font-mono text-xs ${theme.tag}`}>
                      {project.tagline}
                    </span>
                  </div>

                  <!-- Name -->
                  <h3 class="text-2xl sm:text-3xl font-bold text-text group-hover:text-accent transition-colors duration-150">
                    {project.name}
                  </h3>

                  <!-- Description -->
                  <p class="text-text-muted text-sm sm:text-base leading-relaxed">
                    {project.description}
                  </p>

                  <!-- Highlights -->
                  <ul class="flex flex-wrap gap-x-4 gap-y-1.5 text-xs text-text-muted pt-1">
                    {project.highlights.map((highlight) => (
                      <li class="flex items-center gap-1.5">
                        <span class={`w-1 h-1 rounded-full ${theme.accent} opacity-70`} />
                        <span>{highlight}</span>
                      </li>
                    ))}
                  </ul>

                  <!-- Technologies -->
                  <div class="flex flex-wrap gap-1.5 pt-2">
                    {project.technologies.map((tech) => (
                      <span class="px-2.5 py-1 text-xs font-mono bg-surface-alt text-text-muted rounded-md border border-border/80">
                        {tech}
                      </span>
                    ))}
                  </div>

                  <!-- Links -->
                  <div class="flex items-center gap-4 pt-4 mt-1 border-t border-border">
                    {project.github && (
                      <a
                        href={project.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-text hover:text-accent transition-colors"
                      >
                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                        </svg>
                        <span>GitHub Repository</span>
                        <span>↗</span>
                      </a>
                    )}
                    {project.demo && (
                      <a
                        href={project.demo}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-accent hover:underline"
                      >
                        <span>Live Demo</span>
                        <span>↗</span>
                      </a>
                    )}
                  </div>
                </div>

                {/* Restrained Abstract Vector Visual (5 cols) */}
                <div
                  class={`lg:col-span-5 h-48 sm:h-56 lg:h-64 rounded-xl bg-surface-alt/50 border border-border flex items-center justify-center p-6 ${
                    isEven ? "lg:order-1" : "lg:order-2"
                  }`}
                  aria-hidden="true"
                >
                  {/* ZeroK Vault: Minimalist Cryptographic Key & Vault Geometry */}
                  {project.slug === "zerok-vault" && (
                    <svg viewBox="0 0 200 200" class="w-36 h-36 opacity-75 text-cyan-400" xmlns="http://www.w3.org/2000/svg">
                      <circle cx="100" cy="100" r="75" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3" />
                      <circle cx="100" cy="100" r="50" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="4 4" opacity="0.5" />
                      <circle cx="100" cy="100" r="25" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.8" />
                      <rect x="94" y="94" width="12" height="12" rx="2" fill="currentColor" opacity="0.9" />
                      <line x1="100" y1="25" x2="100" y2="40" stroke="currentColor" stroke-width="1.5" />
                      <line x1="100" y1="160" x2="100" y2="175" stroke="currentColor" stroke-width="1.5" />
                      <line x1="25" y1="100" x2="40" y2="100" stroke="currentColor" stroke-width="1.5" />
                      <line x1="160" y1="100" x2="175" y2="100" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  )}

                  {/* Phoenix Drive: Minimalist Cloud Storage & Drive Geometry */}
                  {project.slug === "phoenix-drive" && (
                    <svg viewBox="0 0 200 200" class="w-36 h-36 opacity-75 text-indigo-400" xmlns="http://www.w3.org/2000/svg">
                      <!-- Drive / Workspace Polygon Contour -->
                      <polygon points="100,32 158,66 158,134 100,168 42,134 42,66" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.4" />
                      <!-- Inner Facet Triad (inspired by Drive geometry) -->
                      <polygon points="100,48 145,126 55,126" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.8" />
                      <line x1="100" y1="48" x2="100" y2="126" stroke="currentColor" stroke-width="1" stroke-dasharray="3 3" opacity="0.45" />
                      <!-- Vertex nodes -->
                      <circle cx="100" cy="48" r="3.5" fill="currentColor" opacity="0.9" />
                      <circle cx="145" cy="126" r="3.5" fill="currentColor" opacity="0.9" />
                      <circle cx="55" cy="126" r="3.5" fill="currentColor" opacity="0.9" />
                      <!-- Up/Down sync & transfer accent -->
                      <path d="M 86 148 L 100 138 L 114 148" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.8" />
                      <line x1="100" y1="138" x2="100" y2="158" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.8" />
                    </svg>
                  )}

                  {/* Neurova AI: Minimalist Neural Node Mesh */}
                  {project.slug === "neurova-ai" && (
                    <svg viewBox="0 0 200 200" class="w-36 h-36 opacity-75 text-violet-400" xmlns="http://www.w3.org/2000/svg">
                      <!-- Central Node -->
                      <circle cx="100" cy="100" r="6" fill="currentColor" opacity="0.9" />
                      <circle cx="100" cy="100" r="20" fill="none" stroke="currentColor" stroke-width="1" opacity="0.3" stroke-dasharray="3 3" />
                      <!-- Satellite Nodes -->
                      <circle cx="60" cy="65" r="3.5" fill="currentColor" opacity="0.6" />
                      <circle cx="140" cy="65" r="3.5" fill="currentColor" opacity="0.6" />
                      <circle cx="50" cy="130" r="3.5" fill="currentColor" opacity="0.6" />
                      <circle cx="150" cy="130" r="3.5" fill="currentColor" opacity="0.6" />
                      <circle cx="100" cy="160" r="3.5" fill="currentColor" opacity="0.6" />
                      <!-- Interconnecting Lines -->
                      <line x1="100" y1="100" x2="60" y2="65" stroke="currentColor" stroke-width="1" opacity="0.4" />
                      <line x1="100" y1="100" x2="140" y2="65" stroke="currentColor" stroke-width="1" opacity="0.4" />
                      <line x1="100" y1="100" x2="50" y2="130" stroke="currentColor" stroke-width="1" opacity="0.4" />
                      <line x1="100" y1="100" x2="150" y2="130" stroke="currentColor" stroke-width="1" opacity="0.4" />
                      <line x1="100" y1="100" x2="100" y2="160" stroke="currentColor" stroke-width="1" opacity="0.4" />
                    </svg>
                  )}

                  {/* KernelView: Minimalist CLI System Grid */}
                  {project.slug === "kernelview" && (
                    <svg viewBox="0 0 200 200" class="w-36 h-36 opacity-75 text-emerald-400" xmlns="http://www.w3.org/2000/svg">
                      <rect x="40" y="50" width="120" height="100" rx="6" fill="none" stroke="currentColor" stroke-width="1" opacity="0.4" />
                      <line x1="40" y1="72" x2="160" y2="72" stroke="currentColor" stroke-width="1" opacity="0.3" />
                      <circle cx="52" cy="61" r="2" fill="currentColor" opacity="0.5" />
                      <circle cx="60" cy="61" r="2" fill="currentColor" opacity="0.5" />
                      <circle cx="68" cy="61" r="2" fill="currentColor" opacity="0.5" />
                      <path d="M 55 90 L 65 97 L 55 104" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.8" />
                      <line x1="72" y1="104" x2="85" y2="104" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.8" />
                      <!-- Bar indicator lines -->
                      <line x1="55" y1="120" x2="135" y2="120" stroke="currentColor" stroke-width="2" opacity="0.2" />
                      <line x1="55" y1="120" x2="95" y2="120" stroke="currentColor" stroke-width="2" opacity="0.8" />
                      <line x1="55" y1="130" x2="135" y2="130" stroke="currentColor" stroke-width="2" opacity="0.2" />
                      <line x1="55" y1="130" x2="115" y2="130" stroke="currentColor" stroke-width="2" opacity="0.8" />
                    </svg>
                  )}
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
