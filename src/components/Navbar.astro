---
import { siteConfig } from "../data/site";
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-40 transition-all duration-300"
>
  <div class="absolute inset-0 glass-panel border-b border-border/80 transition-colors duration-200"></div>
  <nav
    class="section-container relative flex items-center justify-between h-16 md:h-18"
    aria-label="Main navigation"
  >
    <!-- Wordmark -->
    <a
      href="#home"
      class="group flex items-center gap-2 text-text font-semibold text-base sm:text-lg tracking-tight transition-colors"
    >
      <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-surface border border-border group-hover:border-accent font-mono text-xs text-accent transition-colors">
        ~
      </span>
      <span class="group-hover:text-accent transition-colors">{siteConfig.wordmark}</span>
    </a>

    <!-- Desktop Navigation Links -->
    <div class="hidden md:flex items-center gap-1">
      {
        siteConfig.nav.map((item) => (
          <a
            href={item.href}
            class="nav-link px-3 py-1.5 text-xs sm:text-sm text-text-muted hover:text-text rounded-lg transition-colors font-medium"
            data-nav-target={item.href.replace("#", "")}
          >
            {item.label}
          </a>
        ))
      }

      {
        siteConfig.availability.enabled && (
          <div class="ml-2 pl-3 border-l border-border flex items-center">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 text-xs font-mono font-medium text-emerald-700 dark:text-emerald-400 bg-emerald-500/10 rounded-full border border-emerald-500/20">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400" />
              {siteConfig.availability.message}
            </span>
          </div>
        )
      }

      <!-- Command Palette Trigger Button -->
      <button
        type="button"
        data-open-palette
        class="ml-3 inline-flex items-center gap-1.5 px-2 py-1 rounded-md border border-border bg-surface text-[11px] font-mono text-text-dim hover:text-text hover:border-border-hover transition-colors"
        aria-label="Open command palette (Ctrl+K)"
        title="Open command palette (Ctrl+K)"
      >
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <span>⌘K</span>
      </button>

      <!-- Theme Toggle -->
      <button
        id="theme-toggle"
        class="ml-1 p-1.5 text-text-muted hover:text-accent rounded-md hover:bg-surface-alt transition-colors"
        aria-label="Toggle theme (press T)"
        title="Toggle theme (press T)"
        type="button"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg
          class="w-4 h-4 theme-icon-sun"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"
          ></path>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg
          class="w-4 h-4 theme-icon-moon hidden"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
          ></path>
        </svg>
      </button>
    </div>

    <!-- Mobile Navigation Triggers -->
    <div class="flex items-center gap-1.5 md:hidden">
      <button
        type="button"
        data-open-palette
        class="p-2 text-text-muted hover:text-text rounded-lg border border-border bg-surface transition-colors"
        aria-label="Open command palette"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>

      <button
        id="theme-toggle-mobile"
        class="p-2 text-text-muted hover:text-text rounded-lg transition-colors"
        aria-label="Toggle theme"
        type="button"
      >
        <svg
          class="w-4 h-4 theme-icon-sun-m"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"
          ></path>
        </svg>
        <svg
          class="w-4 h-4 theme-icon-moon-m hidden"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.8"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
          ></path>
        </svg>
      </button>

      <button
        id="mobile-menu-btn"
        class="p-2 text-text-muted hover:text-text rounded-lg transition-colors border border-border"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        type="button"
      >
        <svg
          class="w-5 h-5 menu-icon"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9h16.5m-16.5 6.75h16.5"></path>
        </svg>
        <svg
          class="w-5 h-5 close-icon hidden"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden absolute top-full left-0 right-0 bg-surface border-b border-border shadow-xl transition-all duration-200"
    role="dialog"
    aria-label="Mobile navigation"
  >
    <div class="section-container py-4 flex flex-col gap-1">
      {
        siteConfig.nav.map((item) => (
          <a
            href={item.href}
            class="mobile-nav-link flex items-center justify-between px-3 py-2.5 text-text-muted hover:text-text hover:bg-surface-alt rounded-lg transition-colors text-sm font-medium"
          >
            <span>{item.label}</span>
            <span class="font-mono text-xs text-text-dim">→</span>
          </a>
        ))
      }
      {
        siteConfig.availability.enabled && (
          <div class="mt-2 pt-2 border-t border-border px-3">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-mono text-emerald-700 dark:text-emerald-400 bg-emerald-500/10 rounded-full border border-emerald-500/20">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 dark:bg-emerald-400" />
              {siteConfig.availability.message}
            </span>
          </div>
        )
      }
    </div>
  </div>
</header>

<script>
  // Mobile Menu Logic
  const menuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const menuIcon = menuBtn?.querySelector(".menu-icon");
  const closeIcon = menuBtn?.querySelector(".close-icon");

  function toggleMobileMenu(open?: boolean) {
    const shouldOpen = open !== undefined ? open : mobileMenu?.classList.contains("hidden");
    if (shouldOpen) {
      mobileMenu?.classList.remove("hidden");
      menuIcon?.classList.add("hidden");
      closeIcon?.classList.remove("hidden");
      menuBtn?.setAttribute("aria-expanded", "true");
    } else {
      mobileMenu?.classList.add("hidden");
      menuIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
      menuBtn?.setAttribute("aria-expanded", "false");
    }
  }

  menuBtn?.addEventListener("click", () => toggleMobileMenu());

  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", () => toggleMobileMenu(false));
  });

  // Active Section Observer for Nav Highlight
  const navLinks = document.querySelectorAll(".nav-link");
  const sections = document.querySelectorAll("section[id]");

  const activeObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute("id");
          navLinks.forEach((link) => {
            const target = link.getAttribute("data-nav-target");
            if (target === id) {
              link.classList.add("text-accent");
              link.classList.remove("text-text-muted");
            } else {
              link.classList.remove("text-accent");
              link.classList.add("text-text-muted");
            }
          });
        }
      });
    },
    { threshold: 0.3 }
  );

  sections.forEach((sec) => activeObserver.observe(sec));

  // Theme Toggling Logic
  function toggleTheme() {
    const isDark = document.documentElement.classList.contains("dark");
    if (isDark) {
      document.documentElement.classList.remove("dark");
      document.documentElement.classList.add("light");
      document.body.classList.add("light");
      localStorage.setItem("theme", "light");
      document.getElementById("theme-color-meta")?.setAttribute("content", "#f8fafc");
    } else {
      document.documentElement.classList.add("dark");
      document.documentElement.classList.remove("light");
      document.body.classList.remove("light");
      localStorage.setItem("theme", "dark");
      document.getElementById("theme-color-meta")?.setAttribute("content", "#080c16");
    }
    syncThemeIcons();
  }

  function syncThemeIcons() {
    const isDark = document.documentElement.classList.contains("dark");
    document.querySelectorAll(".theme-icon-sun, .theme-icon-sun-m").forEach((el) => {
      el.classList.toggle("hidden", !isDark);
    });
    document.querySelectorAll(".theme-icon-moon, .theme-icon-moon-m").forEach((el) => {
      el.classList.toggle("hidden", isDark);
    });
  }

  document.getElementById("theme-toggle")?.addEventListener("click", toggleTheme);
  document.getElementById("theme-toggle-mobile")?.addEventListener("click", toggleTheme);
  syncThemeIcons();

  // Header Elevation on Scroll
  const navbar = document.getElementById("navbar");
  window.addEventListener(
    "scroll",
    () => {
      if (window.scrollY > 30) {
        navbar?.classList.add("shadow-sm");
      } else {
        navbar?.classList.remove("shadow-sm");
      }
    },
    { passive: true }
  );
</script>
