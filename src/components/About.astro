---
import { siteConfig } from "../data/site";
---

<section id="about" class="py-20 md:py-28 relative">
  <div class="section-container">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      <!-- Left Column: Narrative (7 cols) -->
      <div class="lg:col-span-7 space-y-6 reveal">
        <!-- Eyebrow -->
        <div>
          <span class="inline-flex items-center gap-2 font-mono text-xs text-accent tracking-wider uppercase mb-3">
            <span class="w-1.5 h-1.5 rounded-full bg-accent" aria-hidden="true"></span>
            About
          </span>
          <h2 class="text-3xl sm:text-4xl font-bold text-text tracking-tight">
            Curious about systems, privacy, and how software works underneath.
          </h2>
        </div>

        <div class="space-y-4 text-base text-text-muted leading-relaxed">
          <p>
            I'm a full-stack developer based in India with a strong interest in backend engineering
            and systems programming. I enjoy building things end-to-end — from clean, responsive user interfaces
            to resilient server architectures, APIs, and command-line tools.
          </p>
          <p>
            My main language toolkit includes <span class="text-text font-medium">JavaScript</span> and <span class="text-text font-medium">TypeScript</span> for web applications, <span class="text-text font-medium">Go</span> for backend systems and CLI utilities, and <span class="text-text font-medium">Python</span> for scripting and data tasks. I'm drawn to software that respects privacy, gives users real control through self-hosting, and solves practical problems without unnecessary complexity.
          </p>
          <p>
            Outside of coding applications, I spend time exploring Linux system administration, studying networking fundamentals,
            experimenting with homelab services, and contributing to open-source software.
          </p>
        </div>
      </div>

      <!-- Right Column: Currently Exploring (5 cols) -->
      <div class="lg:col-span-5 reveal">
        <div class="p-6 sm:p-7 rounded-2xl bg-surface border border-border clean-card">
          <div class="flex items-center gap-2.5 mb-5 pb-3 border-b border-border">
            <svg class="w-4 h-4 text-accent shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
            </svg>
            <h3 class="font-semibold text-text text-sm sm:text-base">Currently Exploring</h3>
          </div>

          <ul class="space-y-3">
            {siteConfig.currentlyExploring.map((topic) => (
              <li class="flex items-start gap-2.5 text-sm text-text-muted">
                <span class="font-mono text-accent text-xs mt-0.5">→</span>
                <span>{topic}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
