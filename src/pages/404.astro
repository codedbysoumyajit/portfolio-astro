---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="404 — Page Not Found | Soumyajit Das"
  description="The requested route does not exist."
  noIndex={true}
>
  <Navbar />
  <main class="min-h-[80vh] flex items-center justify-center pt-24 pb-16">
    <div class="section-container text-center py-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent/10 border border-accent/20 text-xs font-mono text-accent mb-6">
        <span>ERROR 404</span>
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-text mb-4 tracking-tight">
        Route not found
      </h1>
      <p class="text-text-muted text-base sm:text-lg mb-8 max-w-md mx-auto leading-relaxed">
        The requested endpoint does not exist or has been relocated within the directory tree.
      </p>
      <div class="flex items-center justify-center gap-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-accent text-white dark:text-slate-950 font-medium rounded-lg hover:bg-accent/90 transition-all text-sm font-mono"
        >
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          Return to ~/home
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
